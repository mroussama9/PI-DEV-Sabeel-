<style>
.btn-delete {
    background-color:rgb(255, 62, 81); /* Rouge */
    color: white; /* Texte blanc */
    border: none;
    transition: background-color 0.3s ease-in-out, transform 0.2s;
}

.btn-delete:hover {
    background-color:rgb(213, 53, 69); /* Rouge plus foncé */
    transform: scale(1.05);
}
</style>
<form method="post" action="{{ path('app_terre_delete', {'id': terre.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ terre.id) }}">
    <button type="submit" class="btn btn-delete">
        <i class="bi bi-trash"></i> Supprimer
    </button>


</form>
