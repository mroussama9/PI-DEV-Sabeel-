{% extends 'base.html.twig' %}

{% block title %}Détails de la Terre{% endblock %}

{% block body %}
    <div class="container mt-5">
        <!-- En-tête -->
        <header class="text-center mb-4 p-3 rounded bg-success text-white shadow-lg">
            <h1><i class="bi bi-map"></i> Détails de la Terre</h1>
        </header>

        <!-- Détails de la Terre -->
        <div class="card shadow-lg p-4 mb-4">
            <h3 class="text-center text-success"><i class="bi bi-info-circle"></i> Informations</h3>
            <table class="table table-bordered table-hover text-center align-middle mt-3">
                <tbody>
                    <tr><th>ID</th><td>{{ terre.id }}</td></tr>
                    <tr><th>Nom</th><td>{{ terre.nom }}</td></tr>
                    <tr><th>Gouvernorat</th><td>{{ terre.gouvernorat }}</td></tr>
                    <tr><th>Latitude</th><td>{{ terre.latitude }}</td></tr>
                    <tr><th>Longitude</th><td>{{ terre.longitude }}</td></tr>
                    <tr><th>Superficie</th><td>{{ terre.superficie }} ha</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Boutons d'action -->
        <div class="d-flex justify-content-between mb-4">
            <a href="{{ path('app_terre_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
            <a href="{{ path('app_terre_edit', {'id': terre.id}) }}" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            {{ include('terre/_delete_form.html.twig') }}
        </div>

        <!-- Division en parcelles -->
        <div class="card shadow-lg p-4 mb-4">
            <h3 class="text-center text-primary"><i class="bi bi-grid-3x3-gap"></i> Diviser la Terre en Parcelles</h3>
            <form id="divideForm" class="mt-3">
                <div class="form-group mb-3">
                    <label for="nombreParcelles" class="fw-bold">Nombre de parcelles</label>
                    <input type="number" class="form-control" id="nombreParcelles" name="nombreParcelles" min="1" required>
                </div>
                <button type="button" class="btn btn-primary w-100" onclick="afficherFormulairesParcelles()">
                    <i class="bi bi-diagram-3"></i> Diviser la Terre
                </button>
            </form>
        </div>

        <!-- Formulaire de création des parcelles -->
        <div id="parcellesForm" class="card shadow-lg p-4 mb-4" style="display:none;">
            <h3 class="text-center text-success"><i class="bi bi-tree"></i> Informations des Parcelles</h3>
            <form action="{{ path('app_parcelle_create_multiple', {'id': terre.id}) }}" method="post" class="mt-3">
                <input type="hidden" name="nombreParcelles" id="hiddenNombreParcelles">
                <div id="parcellesContainer" class="row"></div>
                <button type="submit" class="btn btn-success w-100 mt-3">
                    <i class="bi bi-check-circle"></i> Créer les parcelles
                </button>
            </form>
        </div>

        <!-- Lien vers toutes les parcelles -->
        <div class="text-center mt-4">
            <a href="{{ path('app_parcelle_index') }}" class="btn btn-info">
                <i class="bi bi-eye"></i> Voir toutes les parcelles
            </a>
        </div>
    </div>

    <script>
        function afficherFormulairesParcelles() {
            const nombreParcellesInput = document.getElementById('nombreParcelles');
            const nombreParcelles = parseInt(nombreParcellesInput.value, 10);

            if (isNaN(nombreParcelles) || nombreParcelles < 1) {
                alert("Veuillez entrer un nombre valide de parcelles (minimum 1).");
                return;
            }

            const parcellesContainer = document.getElementById('parcellesContainer');
            parcellesContainer.innerHTML = '';

            for (let i = 1; i <= nombreParcelles; i++) {
                parcellesContainer.innerHTML += `
                    <div class="col-md-6">
                        <div class="card shadow-sm p-3 mb-3">
                            <h5 class="text-success">Parcelle ${i}</h5>
                            <div class="form-group">
                                <label for="parcelleNom${i}">Nom</label>
                                <input type="text" class="form-control" id="parcelleNom${i}" name="parcelleNom${i}" required>
                            </div>
                            <div class="form-group">
                                <label for="parcelleSuperficie${i}">Superficie (ha)</label>
                                <input type="number" class="form-control" id="parcelleSuperficie${i}" name="parcelleSuperficie${i}" step="0.01" min="0.01" required>
                            </div>
                        </div>
                    </div>
                `;
            }

            document.getElementById('hiddenNombreParcelles').value = nombreParcelles;
            document.getElementById('parcellesForm').style.display = 'block';
        }
    </script>

    <!-- Custom CSS -->
    <style>
        .card {
            border-radius: 10px;
            transition: all 0.3s ease-in-out;
        }

        .card:hover {
            box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.2);
        }

        .btn {
            transition: all 0.2s ease-in-out;
        }

        .btn:hover {
            opacity: 0.85;
        }

        .form-group label {
            font-weight: bold;
        }

        .form-control {
            border-radius: 8px;
        }

        .card-header {
            font-weight: bold;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .card-footer {
            background-color: #f8f9fa;
            border-bottom-left-radius: 10px;
            border-bottom-right-radius: 10px;
        }
    </style>

    <!-- Import Bootstrap et Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
