{% extends 'base.html.twig' %}

{% block title %}Liste des Parcelles{% endblock %}

{% block body %}
    <div class="container mt-5">
        <!-- En-tête -->
        <header class="text-center mb-4 p-3 rounded bg-success text-white shadow-lg">
            <h1><i class="bi bi-tree"></i> Liste des Parcelles</h1>
        </header>

        <!-- Tableau des parcelles -->
        <div class="card shadow-lg p-4">
            <div class="table-responsive">
                <table class="table table-hover table-bordered text-center align-middle">
                    <thead class="table-success">
                        <tr>
                            <th>Id</th>
                            <th>Nom</th>
                            <th>Superficie</th>
                            <th>Terre associée</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for parcelle in parcelles %}
                            <tr>
                                <td>{{ parcelle.id }}</td>
                                <td><strong>{{ parcelle.nom }}</strong></td>
                                <td>{{ parcelle.superficie }} ha</td>
                                <td>{{ parcelle.terre.nom }}</td>
                                <td>
                                    <a href="{{ path('app_parcelle_show', {'id': parcelle.id}) }}" class="btn btn-info btn-sm">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                    <form action="{{ path('app_parcelle_delete', {'id': parcelle.id}) }}" method="post" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ parcelle.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette parcelle ?');">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-muted text-center p-3">
                                    <i class="bi bi-exclamation-triangle"></i> Aucune parcelle trouvée.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Import Bootstrap et Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
