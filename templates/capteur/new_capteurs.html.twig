{% extends 'base.html.twig' %}

{% block title %}Ajouter des Capteurs{% endblock %}

{% block body %}
    <h1>Ajouter {{ nombreCapteurs }} nouveau(x) capteur(s) pour la parcelle</h1>

    <div id="capteurs-form-container">
        {{ form_start(capteurForm, {'attr': {'id': 'capteur-form'}}) }}
            <div class="capteurs-container">
                {{ form_widget(capteurForm.capteurs) }}
            </div>
            <button type="submit" class="btn btn-success mt-3">Enregistrer les Capteurs</button>
        {{ form_end(capteurForm) }}
    </div>

    <a href="{{ path('app_parcelle_show', { id: parcelle.id }) }}" class="btn btn-secondary mt-3">Annuler</a>

    <!-- 🔥 Script pour gérer la soumission AJAX -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const form = document.querySelector("#capteur-form");

            form.addEventListener("submit", function(event) {
                event.preventDefault(); // Empêcher le rechargement de la page

                const formData = new FormData(form);

                fetch(form.action, {
                    method: "POST",
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest' // 🔥 Indiquer que c'est une requête AJAX
                    }
                })
                .then(response => response.json()) // 🔥 Vérifier que la réponse est bien JSON
                .then(data => {
                    if (data.success) {
                        // 🔥 Rediriger vers la page de la parcelle après l'ajout des capteurs
                        window.location.href = data.redirect;
                    } else {
                        alert("Erreur lors de l'ajout des capteurs.");
                    }
                })
                .catch(error => {
                    console.error("Erreur AJAX:", error);
                    alert("Une erreur s'est produite lors de l'ajout des capteurs.");
                });
            });
        });
    </script>
{% endblock %}
